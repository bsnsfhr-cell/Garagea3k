                        </div>
                        <ul class="space-y-4 mb-12 text-gray-600 font-medium">
                            <li class="flex items-center gap-3"><i data-lucide="check" class="text-amber-500 w-5 h-5"></i> Kuras Oli Transmisi (ATF)</li>
                            <li class="flex items-center gap-3"><i data-lucide="check" class="text-amber-500 w-5 h-5"></i> Ganti Filter Bensin & AC</li>
                            <li class="flex items-center gap-3"><i data-lucide="check" class="text-amber-500 w-5 h-5"></i> Kuras Radiator Coolant</li>
                            <li class="flex items-center gap-3"><i data-lucide="check" class="text-amber-500 w-5 h-5"></i> Penggantian Busi Iridium</li>
                        </ul>
                        <button onclick="sendWhatsApp('Halo Garage A3K, saya ingin booking paket besar: Total Revival (Rp 3.800.000)')" class="w-full py-4 border-2 border-black rounded-full font-bold group-hover:bg-black group-hover:text-white transition">Pilih Paket</button>
